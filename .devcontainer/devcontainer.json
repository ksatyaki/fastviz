// fastviz dev container — ROS2 Jazzy + r2r + Vulkan (NVIDIA-capable).
//
// Host prereqs (Fedora):
//   sudo dnf install -y nvidia-container-toolkit
//   sudo nvidia-ctk runtime configure --runtime=docker
//   sudo systemctl restart docker        # or use podman; see README
//   xhost +SI:localuser:$(whoami)        # before first run
//
// Build/runtime config (image, mounts, GPU, env, network) lives in
// docker-compose.yml. On a non-NVIDIA host, drop the `deploy:` block from
// docker-compose.yml and Mesa llvmpipe will be used.
{
    "name": "fastviz dev (jazzy + vulkan)",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "jazzy",
    "workspaceFolder": "/workspaces/fastviz",
    "remoteUser": "dev",

    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "vadimcn.vscode-lldb",
                "ms-iot.vscode-ros",
                "Anthropic.claude-code"
            ],
            "settings": {
                "rust-analyzer.cargo.features": "all",
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },

    "postCreateCommand": "vulkaninfo --summary 2>&1 | head -30 || true"
}
