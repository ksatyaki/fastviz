// fastviz dev container — ROS2 Jazzy + r2r + Vulkan (NVIDIA-capable).
//
// Host prereqs (Fedora):
//   sudo dnf install -y nvidia-container-toolkit
//   sudo nvidia-ctk runtime configure --runtime=docker
//   sudo systemctl restart docker        # or use podman; see README
//   xhost +SI:localuser:$(whoami)        # before first run
//
// On a non-NVIDIA host: drop "--gpus=all" from runArgs and Mesa llvmpipe will be used.
{
    "name": "fastviz dev (jazzy + vulkan)",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "dev",
            "USER_UID": "1000",
            "USER_GID": "1000"
        }
    },

    "workspaceFolder": "/workspaces/fastviz",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/fastviz,type=bind",

    "remoteUser": "dev",

    // Mount the host's ~/.claude so prior conversations and credentials are
    // visible to `claude` running inside the container. Drop this mount if
    // you want a clean session store.
    "mounts": [
        "source=${localEnv:HOME}/.claude,target=/home/dev/.claude,type=bind",
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
    ],

    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "QT_X11_NO_MITSHM": "1",
        "NVIDIA_VISIBLE_DEVICES": "all",
        "NVIDIA_DRIVER_CAPABILITIES": "graphics,utility,compute",
        "WGPU_BACKEND": "vulkan",
        "RUST_LOG": "info"
    },

    "runArgs": [
        "--gpus=all",
        "--ipc=host",
        "--network=host",
        "--device=/dev/dri"
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "vadimcn.vscode-lldb",
                "ms-iot.vscode-ros"
            ],
            "settings": {
                "rust-analyzer.cargo.features": "all",
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },

    "postCreateCommand": "vulkaninfo --summary 2>&1 | head -30 || true"
}
